<Window x:Class="CashFlowTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Cash Flow Tracker" Height="600" Width="900">

    <TabControl>
        <!-- ========== Transactions Tab ========== -->
        <TabItem Header="Transactions">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- input + button row -->
                    <RowDefinition Height="Auto"/>
                    <!-- search/filter row -->
                    <RowDefinition Height="*"/>
                    <!-- data grid fills remaining space -->
                </Grid.RowDefinitions>

                <!-- Input Panel: date, amount, category name, type, description, actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                    <DatePicker x:Name="dpDate" Width="120" Margin="0,0,5,0"
                                SelectedDate="{x:Static sys:DateTime.Today}" />
                    <TextBox x:Name="txtAmount" Width="80" Margin="0,0,5,0" Text="0" />
                    <TextBox x:Name="txtCategoryName" Width="100" Margin="0,0,5,0" Text="Food" />
                    <ComboBox x:Name="cmbType" Width="80" Margin="0,0,5,0" SelectedIndex="0">
                        <ComboBoxItem>Expense</ComboBoxItem>
                        <ComboBoxItem>Revenue</ComboBoxItem>
                    </ComboBox>
                    <TextBox x:Name="txtDescription" Width="120" Margin="0,0,5,0" Text="Lunch" />
                    <Button x:Name="btnAdd" Content="Add" Width="60" Click="btnAdd_Click"/>
                    <Button x:Name="btnSave" Content="Save" Width="60" Margin="5,0,0,0" Click="btnSave_Click"/>
                    <Button x:Name="btnLoad" Content="Load" Width="60" Margin="5,0,0,0" Click="btnLoad_Click"/>
                </StackPanel>

                <!-- Search & Filter Panel -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="1">
                    <TextBox x:Name="txtSearch" Width="150" Margin="0,0,5,0" />
                    <Button x:Name="btnSearch" Content="Search Text" Width="80" Click="btnSearch_Click"/>
                    <Button x:Name="btnSearchDate" Content="Search Date" Width="80" Margin="5,0,0,0" Click="btnSearchDate_Click"/>
                    <!-- -1 = no filter selected (show all types) -->
                    <ComboBox x:Name="cmbFilterType" Width="80" Margin="5,0,0,0"
                              SelectedIndex="-1" SelectionChanged="cmbFilterType_SelectionChanged">
                        <ComboBoxItem>Expense</ComboBoxItem>
                        <ComboBoxItem>Revenue</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="btnClearFilter" Content="Clear" Width="60" Margin="5,0,0,0" Click="btnClearFilter_Click"/>
                </StackPanel>

                <!-- Main transaction list (auto‑generated columns from record properties) -->
                <DataGrid x:Name="dataGridTransactions" Grid.Row="2"
                          AutoGenerateColumns="True" IsReadOnly="True"/>
            </Grid>
        </TabItem>

        <!-- ========== Monthly View Tab ========== -->
        <TabItem Header="Monthly View">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- month picker + report button -->
                    <RowDefinition Height="Auto"/>
                    <!-- totals text -->
                    <RowDefinition Height="*"/>
                    <!-- transactions for selected month -->
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <!-- Month dropdown, populated from FinanceManager in code‑behind -->
                    <ComboBox x:Name="cmbMonth" Width="150"
                              SelectionChanged="cmbMonth_SelectionChanged"/>
                    <Button x:Name="btnGenerateReport" Content="Generate Report"
                            Width="110" Margin="10,0,0,0" Click="btnGenerateReport_Click"/>
                </StackPanel>

                <!-- Displays revenues, expenses, and net cash‑flow for selected month -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="txtMonthlyTotals" FontWeight="Bold"/>
                </StackPanel>

                <!-- Transactions filtered to the chosen month -->
                <DataGrid x:Name="dataGridMonthlyTransactions" Grid.Row="2"
                          Margin="0,10,0,0" AutoGenerateColumns="True" IsReadOnly="True"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>